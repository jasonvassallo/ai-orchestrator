{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jasonvassallo/ai-orchestrator/config-schema.json",
  "title": "AI Orchestrator Configuration",
  "description": "Configuration schema for the AI Orchestrator. API keys should NEVER be stored in this file - use the secure credential manager instead.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Configuration schema version",
      "const": "2.0.0"
    },
    "defaults": {
      "type": "object",
      "description": "Default settings for the orchestrator",
      "properties": {
        "preferLocal": {
          "type": "boolean",
          "description": "Prefer local models (MLX) for privacy",
          "default": false
        },
        "localProvider": {
          "type": "string",
          "description": "Preferred local inference provider when local routing is enabled",
          "enum": ["any", "mlx"],
          "default": "mlx"
        },
        "costOptimize": {
          "type": "boolean",
          "description": "Optimize for lower cost models when possible",
          "default": false
        },
        "enableLLMRouting": {
          "type": "boolean",
          "description": "Enable LLM-based routing for model selection",
          "default": false
        },
        "routerAllTasks": {
          "type": "boolean",
          "description": "Use the LLM router for every prompt (not just multi-task prompts)",
          "default": false
        },
        "enableWebSearch": {
          "type": "boolean",
          "description": "Allow supported models to use web search for current-information prompts",
          "default": true
        },
        "routingModel": {
          "type": "string",
          "description": "Model registry key (or raw model id) used for LLM routing",
          "default": "gemini-3-flash-preview"
        },
        "preferSubscriptionProviders": {
          "type": "array",
          "description": "Providers to prefer for advanced tasks when available",
          "items": {
            "type": "string"
          },
          "default": ["vertex-ai"]
        },
        "preferSubscriptionModels": {
          "type": "array",
          "description": "Specific model keys to prefer for advanced tasks",
          "items": {
            "type": "string"
          },
          "default": ["vertex-gemini-3-pro"]
        },
        "maxTokens": {
          "type": "integer",
          "description": "Default maximum tokens in response",
          "minimum": 100,
          "maximum": 100000,
          "default": 4096
        },
        "temperature": {
          "type": "number",
          "description": "Default temperature for response generation",
          "minimum": 0,
          "maximum": 2,
          "default": 0.7
        },
        "timeout": {
          "type": "integer",
          "description": "Request timeout in seconds",
          "minimum": 10,
          "maximum": 600,
          "default": 120
        }
      }
    },
    "models": {
      "type": "object",
      "description": "Model configuration overrides",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Whether this model is enabled",
            "default": true
          },
          "priority": {
            "type": "integer",
            "description": "Priority for model selection (higher = preferred)",
            "minimum": 0,
            "maximum": 100,
            "default": 50
          },
          "maxTokens": {
            "type": "integer",
            "description": "Override max tokens for this model"
          },
          "temperature": {
            "type": "number",
            "description": "Override temperature for this model"
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "description": "Provider-specific configuration (NOT for API keys!)",
      "properties": {
        "openai": {
          "type": "object",
          "properties": {
            "organization": {
              "type": "string",
              "description": "OpenAI organization ID (optional)"
            },
            "baseUrl": {
              "type": "string",
              "description": "Custom API base URL (for proxies or Azure)",
              "default": "https://api.openai.com/v1"
            }
          }
        },
        "anthropic": {
          "type": "object",
          "properties": {
            "baseUrl": {
              "type": "string",
              "description": "Custom API base URL",
              "default": "https://api.anthropic.com"
            }
          }
        },
        "vertex-ai": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "description": "Vertex AI location (use 'global' for preview/global-only models)",
              "default": "global"
            }
          }
        }
      }
    },
    "rateLimits": {
      "type": "object",
      "description": "Rate limiting configuration per provider",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "requestsPerMinute": {
            "type": "integer",
            "description": "Maximum requests per minute",
            "minimum": 1,
            "default": 60
          },
          "tokensPerMinute": {
            "type": "integer",
            "description": "Maximum tokens per minute",
            "minimum": 1000,
            "default": 100000
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "description": "Logging configuration",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR"],
          "default": "INFO"
        },
        "file": {
          "type": "string",
          "description": "Log file path (optional, logs to console if not set)"
        },
        "redactSensitive": {
          "type": "boolean",
          "description": "Redact potentially sensitive content in logs",
          "default": true
        }
      }
    },
    "security": {
      "type": "object",
      "description": "Security settings",
      "properties": {
        "maxPromptLength": {
          "type": "integer",
          "description": "Maximum allowed prompt length in characters",
          "minimum": 1000,
          "maximum": 1000000,
          "default": 500000
        },
        "maxMessages": {
          "type": "integer",
          "description": "Maximum messages in conversation history",
          "minimum": 10,
          "maximum": 1000,
          "default": 100
        },
        "allowRemoteExecution": {
          "type": "boolean",
          "description": "Allow code execution features (use with caution)",
          "default": false
        }
      }
    },
    "agent": {
      "type": "object",
      "description": "Codex-like local agent runtime settings",
      "properties": {
        "enabledByDefault": {
          "type": "boolean",
          "default": false,
          "description": "Enable agent mode by default in compatible clients"
        },
        "defaultModel": {
          "type": "string",
          "default": "mlx-qwen3-coder-30b",
          "description": "Default model key used in agent mode"
        },
        "defaultSessionId": {
          "type": "string",
          "default": "default",
          "description": "Default session id for persistent agent conversations"
        },
        "profile": {
          "type": "string",
          "enum": ["fast", "balanced", "deep"],
          "default": "balanced",
          "description": "Execution profile controlling default limits/timeouts"
        },
        "enableWebTools": {
          "type": "boolean",
          "default": true
        },
        "enableMcp": {
          "type": "boolean",
          "default": true
        },
        "enableSkills": {
          "type": "boolean",
          "default": true
        },
        "enableBrowserAutomation": {
          "type": "boolean",
          "default": false,
          "description": "Dangerous capability: browser automation is off by default"
        },
        "codexHome": {
          "type": "string",
          "default": "~/.codex"
        },
        "claudeHome": {
          "type": "string",
          "default": "~/.claude"
        },
        "geminiHome": {
          "type": "string",
          "default": "~/.gemini"
        },
        "memory": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "default": "~/.ai_orchestrator/agent_memory.md"
            },
            "conversationDir": {
              "type": "string",
              "default": "~/.ai_orchestrator/agent_conversations"
            },
            "autoRememberPatterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "web": {
          "type": "object",
          "properties": {
            "searxngBaseUrl": {
              "type": "string",
              "default": "http://127.0.0.1:8080"
            },
            "language": {
              "type": "string",
              "default": "en-US"
            },
            "userAgent": {
              "type": "string",
              "default": "ai-orchestrator-agent/1.0 (+local-model)"
            }
          }
        },
        "compatibility": {
          "type": "object",
          "properties": {
            "skillSources": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["codex", "claude", "gemini"]
              },
              "default": ["codex", "claude", "gemini"]
            },
            "mcpSources": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["codex", "claude", "gemini"]
              },
              "default": ["codex", "claude", "gemini"]
            }
          }
        },
        "limits": {
          "type": "object",
          "description": "Fine-grained developer controls for timeouts and truncation",
          "properties": {
            "maxSteps": {
              "type": "integer",
              "minimum": 1,
              "default": 10
            },
            "modelTimeoutSeconds": {
              "type": "number",
              "minimum": 1,
              "default": 90
            },
            "toolTimeoutSeconds": {
              "type": "number",
              "minimum": 1,
              "default": 40
            },
            "shellTimeoutSeconds": {
              "type": "number",
              "minimum": 1,
              "default": 30
            },
            "webSearchTimeoutSeconds": {
              "type": "number",
              "minimum": 1,
              "default": 20
            },
            "webFetchTimeoutSeconds": {
              "type": "number",
              "minimum": 1,
              "default": 25
            },
            "maxPromptChars": {
              "type": "integer",
              "minimum": 2000,
              "default": 24000
            },
            "maxToolOutputChars": {
              "type": "integer",
              "minimum": 500,
              "default": 10000
            },
            "maxShellOutputChars": {
              "type": "integer",
              "minimum": 200,
              "default": 8000
            },
            "maxFetchedChars": {
              "type": "integer",
              "minimum": 500,
              "default": 12000
            },
            "maxWebResults": {
              "type": "integer",
              "minimum": 1,
              "default": 8
            },
            "maxMemoryContextChars": {
              "type": "integer",
              "minimum": 500,
              "default": 9000
            },
            "maxHistoryMessages": {
              "type": "integer",
              "minimum": 1,
              "default": 24
            }
          }
        }
      }
    },
    "taskRouting": {
      "type": "object",
      "description": "Custom task type to model mapping",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "List of model keys to use for this task type"
      }
    }
  },
  "required": ["version"]
}
