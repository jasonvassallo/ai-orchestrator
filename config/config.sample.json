{
  "$schema": "./config-schema.json",
  "version": "2.0.0",
  "_comment": "\u26a0\ufe0f SECURITY: NEVER store API keys in this file! Use the credential manager instead.",
  "defaults": {
    "preferLocal": false,
    "localProvider": "mlx",
    "costOptimize": false,
    "enableLLMRouting": true,
    "routerAllTasks": true,
    "enableWebSearch": true,
    "routingModel": "gemini-3-flash-preview",
    "preferSubscriptionProviders": [
      "vertex-ai"
    ],
    "preferSubscriptionModels": [
      "vertex-gemini-3-pro"
    ],
    "maxTokens": 4096,
    "temperature": 0.7,
    "timeout": 120
  },
  "models": {
    "claude-opus-4.6": {
      "enabled": true,
      "priority": 90
    },
    "claude-sonnet-4.5": {
      "enabled": true,
      "priority": 80
    },
    "gpt-4o": {
      "enabled": true,
      "priority": 75
    },
    "gpt-5.2": {
      "enabled": true,
      "priority": 85
    },
    "o1": {
      "enabled": true,
      "priority": 85
    },
    "gemini-2.0-flash": {
      "enabled": true,
      "priority": 70
    },
    "mlx-llama-vision-11b": {
      "enabled": true,
      "priority": 60
    },
    "mlx-qwen3-coder-30b": {
      "enabled": true,
      "priority": 78
    },
    "mlx-qwen3-vl-30b": {
      "enabled": true,
      "priority": 70
    }
  },
  "providers": {
    "openai": {
      "organization": "",
      "baseUrl": "https://api.openai.com/v1"
    },
    "anthropic": {
      "baseUrl": "https://api.anthropic.com"
    },
    "vertex-ai": {
      "location": "global"
    }
  },
  "rateLimits": {
    "openai": {
      "requestsPerMinute": 60,
      "tokensPerMinute": 150000
    },
    "anthropic": {
      "requestsPerMinute": 60,
      "tokensPerMinute": 100000
    },
    "google": {
      "requestsPerMinute": 60,
      "tokensPerMinute": 120000
    }
  },
  "logging": {
    "level": "INFO",
    "redactSensitive": true
  },
  "security": {
    "maxPromptLength": 500000,
    "maxMessages": 100,
    "allowRemoteExecution": false
  },
  "agent": {
    "enabledByDefault": false,
    "defaultModel": "mlx-qwen3-coder-30b",
    "defaultSessionId": "default",
    "profile": "balanced",
    "enableWebTools": true,
    "enableMcp": true,
    "enableSkills": true,
    "enableBrowserAutomation": false,
    "codexHome": "~/.codex",
    "claudeHome": "~/.claude",
    "geminiHome": "~/.gemini",
    "memory": {
      "filePath": "~/.ai_orchestrator/agent_memory.md",
      "conversationDir": "~/.ai_orchestrator/agent_conversations",
      "autoRememberPatterns": [
        "remember this",
        "don't forget",
        "save this",
        "note this"
      ]
    },
    "web": {
      "searxngBaseUrl": "http://127.0.0.1:8080",
      "language": "en-US",
      "userAgent": "ai-orchestrator-agent/1.0 (+local-model)"
    },
    "compatibility": {
      "skillSources": [
        "codex",
        "claude",
        "gemini"
      ],
      "mcpSources": [
        "codex",
        "claude",
        "gemini"
      ]
    },
    "limits": {
      "maxSteps": 10,
      "modelTimeoutSeconds": 90,
      "toolTimeoutSeconds": 40,
      "shellTimeoutSeconds": 30,
      "webSearchTimeoutSeconds": 20,
      "webFetchTimeoutSeconds": 25,
      "maxPromptChars": 24000,
      "maxToolOutputChars": 10000,
      "maxShellOutputChars": 8000,
      "maxFetchedChars": 12000,
      "maxWebResults": 8,
      "maxMemoryContextChars": 9000,
      "maxHistoryMessages": 24
    }
  },
  "taskRouting": {
    "general": [
      "mlx-ministral-14b-reasoning",
      "vertex-gemini-3-flash",
      "vertex-gemini-3-pro"
    ],
    "code": [
      "mlx-qwen3-coder-30b",
      "kimi-k2-thinking",
      "vertex-gemini-3-pro"
    ],
    "reasoning": [
      "kimi-k2-thinking",
      "vertex-gemini-3-pro"
    ],
    "math": [
      "kimi-k2-thinking",
      "vertex-gemini-3-pro"
    ],
    "data-analysis": [
      "vertex-gemini-3-pro"
    ],
    "multimodal": [
      "vertex-gemini-3-pro",
      "mlx-llama-vision-11b"
    ],
    "long-context": [
      "vertex-gemini-3-pro"
    ],
    "websearch": [
      "perplexity-sonar-pro",
      "perplexity-sonar-reasoning-pro"
    ],
    "creative": [
      "vertex-gemini-3-pro",
      "claude-opus-4.6"
    ],
    "summarization": [
      "claude-haiku-4.5",
      "vertex-gemini-3-flash"
    ],
    "local": [
      "mlx-qwen3-coder-30b",
      "mlx-qwen3-vl-30b",
      "mlx-llama-vision-11b",
      "mlx-ministral-14b-reasoning"
    ]
  },
  "musicGeneration": {
    "_comment": "MusicGen AI model for audio generation (requires .music-venv)",
    "defaultModel": "musicgen-small",
    "availableModels": [
      "musicgen-small",
      "musicgen-medium",
      "musicgen-large",
      "musicgen-stereo-small",
      "musicgen-stereo-medium",
      "musicgen-stereo-large",
      "musicgen-melody",
      "musicgen-melody-large"
    ]
  }
}
